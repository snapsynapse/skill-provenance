{
  "$schema": "portfolio-search-indexing-audit/v4",
  "contractVersion": 4,
  "canonicalOrigin": "https://skillprovenance.dev/",
  "outputDir": ".",
  "sitemaps": [
    "sitemap.xml"
  ],
  "minimumWords": 120,
  "thinPageExemptions": [],
  "expectedNoindex": [
    "/404.html"
  ],
  "requireJsonLd": false,
  "jsonLdRequiredPaths": [
    "/"
  ],
  "lastmodAgreementPaths": [
    "/"
  ],
  "compareRepositorySitemaps": true,
  "internalSourceRules": [],
  "requiredFiles": [
    {
      "path": "index.html",
      "contentTypes": [
        "text/html"
      ],
      "contains": [
        "gh skill install snapsynapse/skill-provenance skill-provenance@v6.3.0 --agent codex --scope user",
        "Bundle releases use vX.Y.Z tags; GuideCheck releases use guidecheck-X.Y.Z tags.",
        "href=\"/llms.txt\"",
        "href=\"/verify.sh\""
      ]
    },
    {
      "path": "robots.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "Sitemap: https://skillprovenance.dev/sitemap.xml"
      ]
    },
    {
      "path": "sitemap.xml",
      "contentTypes": [
        "application/xml",
        "text/xml"
      ],
      "contains": []
    },
    {
      "path": "llms.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "Skill Provenance",
        "https://github.com/snapsynapse/skill-provenance",
        "Release tag families",
        "https://github.com/snapsynapse/skill-provenance/releases/tag/v6.3.0"
      ]
    },
    {
      "path": "verify.sh",
      "contentTypes": [
        "text/plain",
        "text/x-shellscript",
        "application/x-sh"
      ],
      "contains": [
        "VALIDATOR_SHA256=\"cac9624665345d317fd37edf183defd5553f8a2afaed736c07f58f597ae55c05\"",
        "https://raw.githubusercontent.com/snapsynapse/skill-provenance/main/skill-provenance/validate.sh"
      ]
    },
    {
      "path": ".well-known/assistant-guide-manifest.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "guide-path: /.well-known/assistant-guide.txt",
        "canonical-url: https://skillprovenance.dev/.well-known/assistant-guide.txt"
      ]
    },
    {
      "path": ".well-known/assistant-guide.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "Assistant Guide: Skill Provenance",
        "canonical-url: https://skillprovenance.dev/.well-known/assistant-guide.txt"
      ]
    }
  ],
  "redirects": [
    {
      "from": "http://skillprovenance.dev/",
      "to": "https://skillprovenance.dev/"
    },
    {
      "from": "https://www.skillprovenance.dev/",
      "to": "https://skillprovenance.dev/"
    },
    {
      "from": "http://www.skillprovenance.dev/",
      "to": "https://skillprovenance.dev/"
    }
  ],
  "hosted404Patterns": [
    "This page doesn't exist.",
    "There isn't a GitHub Pages site here",
    "<title>Page not found",
    "404 File not found",
    "<title>Page not found — Skill Provenance</title>"
  ],
  "expectedNotFoundPaths": [
    "/__search-audit-404__"
  ]
}
